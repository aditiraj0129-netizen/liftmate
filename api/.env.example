# ---- Supabase (Project Settings > API) ----
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
# The "service_role" secret key. Keep it ONLY here, never in the web app.
SUPABASE_SERVICE_KEY=PASTE-YOUR-SERVICE-ROLE-KEY

# ---- Google Gemini (free key from https://aistudio.google.com/apikey) ----
GEMINI_API_KEY=PASTE-YOUR-GEMINI-KEY
# "gemini-flash-latest" always points to Google's newest Flash model.
GEMINI_MODEL=gemini-flash-latest

# ---- Optional backup AI if Gemini hits its free limit (https://console.groq.com/keys) ----
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Optional: official Azure Speech for the coach voice (free 0.5M characters/month) ----
# Leave empty to use the free edge-tts voices. https://portal.azure.com > Create 'Speech service'
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia

# ---- Where the web app runs (for browser permission / CORS) ----
FRONTEND_URL=http://localhost:3000
